# Dashboard Data API — copy this file to `.env.local` (gitignored) and fill in.
#
# Base URL up to and including /api (no trailing slash). From the API's
# openapi.yaml `servers` block:
VITE_DASH_API_BASE_URL=https://get-fingertips-data-akateqfdbxepgcht.uksouth-01.azurewebsites.net/api

# Azure Functions key. This is shipped to the browser and is effectively
# non-secret (the API serves read-only, aggregated, non-identifiable data),
# but it is still required to call the function.
VITE_DASH_API_KEY=
